CREATE DATABASE IF NOT EXISTS Brain_Up 
DEFAULT CHARACTER SET utf8mb4 
COLLATE utf8mb4_0900_ai_ci;

USE Brain_Up;

CREATE TABLE IF NOT EXISTS estudante (
    id_estudante INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(50) NOT NULL,
    data_nascimento DATE,
    senha VARCHAR(20),             
    email VARCHAR(50) NOT NULL,  
    frequencia_estudante BOOLEAN
) CHARACTER SET utf8mb4;

DESC estudante;


CREATE TABLE IF NOT EXISTS atividade (
    id_atividade INT PRIMARY KEY AUTO_INCREMENT,
    tempo_inicio DATETIME,
    materia VARCHAR(30),
    nota INT,
    tempo_desejado TIME,
    duracao TIME,
    nivel_dificuldade ENUM('fácil', 'médio', 'difícil'),
    status_n ENUM('pendente', 'concluída'),
    id_estudante INT,
    FOREIGN KEY (id_estudante) REFERENCES estudante(id_estudante)
) CHARACTER SET utf8mb4;

DESC atividade;

